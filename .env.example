# AI-Based Smart Examination Proctoring System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit secrets.

# =============================================================================
# PRODUCTION vs DEVELOPMENT
# =============================================================================
# For local development:
#   DATABASE_MODE=local
#   DEBUG=True
#   DEMO_MODE_ENABLED=True
#   OTP_PROVIDER=console
#
# For production (Railway / Render / Docker):
#   DATABASE_MODE=mongodb
#   DEBUG=False
#   DEMO_MODE_ENABLED=False
#   OTP_PROVIDER=smtp
#   HOST=0.0.0.0
#   JWT_SECRET_KEY=<strong random secret>
# =============================================================================

# ---- Server ----
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- Database ----
# "mongodb" = MongoDB Atlas (production). "local" = file-backed JSON (dev/demo).
DATABASE_MODE=local
# MongoDB Atlas connection string (used when DATABASE_MODE=mongodb):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smart_proctor_db

# ---- Security & JWT ----
# WARNING: Change this to a strong random secret in production!
JWT_SECRET_KEY=smart_proctoring_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Login rate-limiting / lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Admin registration invite code
ADMIN_INVITE_CODE=PROCTOR-ADMIN-2026

# ---- One-Time Passcode (OTP) ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Delivery provider: console | smtp | none
OTP_PROVIDER=console
# FOR LOCAL TESTING ONLY — echoes the OTP to server logs. NEVER enable in production.
DEV_ECHO_OTP=False

# ---- SMTP provider (required when OTP_PROVIDER=smtp) ----
#
# === Gmail setup ===
# 1. Enable 2-Factor Authentication on your Google account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
#    - Select "Mail" as the app.
#    - Google will show a 16-character password. Copy it.
# 3. Set the values below (use the App Password, NOT your regular Gmail password):
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your.email@gmail.com
#   SMTP_PASSWORD=<the-16-char-app-password>
#   SMTP_FROM_EMAIL=your.email@gmail.com
#   SMTP_USE_TLS=True
#
# === Other providers (Outlook, Yahoo, custom SMTP) ===
# Adjust SMTP_HOST, SMTP_PORT, and SMTP_USE_TLS accordingly.
# Common: Outlook smtp-mail.outlook.com:587, Yahoo smtp.mail.yahoo.com:587.
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# ---- Frontend (Vite build-time variables) ----
# Set in frontend/.env.production, NOT here.
# VITE_API_BASE_URL=https://your-backend.railway.app

# ---- Storage ----
DATA_STORE_DIR=./data_store

# ---- AI Proctoring Config & Suspicion Weights ----
WEIGHT_FACE_NOT_DETECTED=20
WEIGHT_MULTIPLE_PERSONS=40
WEIGHT_MOBILE_PHONE=50
WEIGHT_SUSPICIOUS_HEAD_MOVEMENT=10
WEIGHT_AUDIO_ACTIVITY=20
WEIGHT_STUDENT_ABSENT=30

# Thresholds & Cooldowns
HEAD_POSE_YAW_THRESHOLD=25.0
HEAD_POSE_PITCH_THRESHOLD=20.0
PHONE_CONFIDENCE_THRESHOLD=0.40
PHONE_DETECTION_DEBUG=True
PHONE_TEMPORAL_FRAMES=2
PHONE_TEMPORAL_WINDOW_SECONDS=1.5
AUDIO_ENERGY_THRESHOLD=0.03
EVIDENCE_COOLDOWN_SECONDS=5.0
ABSENCE_TIMEOUT_SECONDS=8.0

# ---- Paths ----
EVIDENCE_DIR=./evidence
MODELS_DIR=./models/weights
YOLO_MODEL_PATH=yolov8n.pt

# ---- Test/Demo Mode ----
DEMO_MODE_ENABLED=True